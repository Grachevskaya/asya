<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        This permission is used for:
        - Check the updates

        And it is your choice to enable its functionality in the app's settings
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- This permission is used for make the package list changed listener work -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />

    <!-- This permission is used for uninstalling the conflicted packages -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name="io.github.grachevskaya.asya.MyApp"
        android:allowBackup="true"
        android:fullBackupOnly="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <activity
            android:name="io.github.grachevskaya.asya.ui.activity.MainActivity"
            android:exported="true"
            android:configChanges="assetsPaths|colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|resourcesUnused|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:windowSoftInputMode="adjustPan" />

        <activity-alias
            android:name=".MainActivityLauncher"
            android:exported="true"
            android:targetActivity="io.github.grachevskaya.asya.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt"
            android:targetActivity="io.github.grachevskaya.asya.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt2"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt_2"
            android:targetActivity="io.github.grachevskaya.asya.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt3"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt_3"
            android:targetActivity="io.github.grachevskaya.asya.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLauncherAlt4"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_alt_4"
            android:targetActivity="io.github.grachevskaya.asya.ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="io.github.grachevskaya.asya.service.ServiceProvider"
            android:authorities="${applicationId}.ServiceProvider"
            android:exported="false" />

    </application>
</manifest>
