<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.AppTheme.Light" parent="Theme.Material3Expressive.DynamicColors.Light">
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Preference title -->
        <item name="android:textAppearanceListItem">?attr/textAppearanceTitleMedium</item>

        <item name="alertDialogTheme">@style/AppTheme.AlertDialog.Light</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog.Light</item>
        <item name="dialogCornerRadius">@dimen/shape_corner_extra_large</item>
    </style>

    <style name="Theme.Light" parent="Base.AppTheme.Light" />

    <style name="Base.AppTheme" parent="Theme.Material3Expressive.DynamicColors.Dark">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Preference title -->
        <item name="android:textAppearanceListItem">?attr/textAppearanceTitleMedium</item>

        <item name="alertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/AppTheme.AlertDialog</item>
        <item name="dialogCornerRadius">@dimen/shape_corner_extra_large</item>
    </style>

    <style name="Theme" parent="Base.AppTheme" />

    <style name="AppTheme.SideImage">
        <item name="android:layout_width">@dimen/vector_icon_size</item>
        <item name="android:layout_height">@dimen/vector_icon_size</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="AppTheme.AppIcon">
        <item name="android:layout_width">@dimen/app_icon_size</item>
        <item name="android:layout_height">@dimen/app_icon_size</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="AppTheme.ElevatedCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/shape_corner_extra_large</item>
        <item name="cardElevation">@dimen/primary_elevation</item>
    </style>

    <style name="AppTheme.OutlinedCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/shape_corner_extra_large</item>
        <item name="cardElevation">@dimen/secondary_elevation</item>
    </style>

    <!-- The group titles of a settings screen stand where its cards do; the library indents them
         past an icon frame a category does not draw, and this layout leaves that frame out. -->
    <style name="Preference.Category.Material" parent="@style/Preference.Category">
        <item name="android:layout">@layout/preference_category_row</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat" parent="@style/Preference.SwitchPreferenceCompat.Material"
        tools:ignore="ResourceCycle">
        <item name="widgetLayout">@layout/switch_compat</item>
    </style>

    <style name="AppTheme.AlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="android:background">?colorPrimarySurface</item>
        <!--
             The mark a multi-choice row draws. The library row takes it from this framework
             attribute, the theme chain did not resolve it into anything visible, and a list where
             nothing shows what is selected is a list that cannot be used: this is the Material
             checkbox state list, so the row shows the same box the rest of the app does.
        -->
    </style>

    <style name="AppTheme.AlertDialog.Light" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
    </style>
</resources>
