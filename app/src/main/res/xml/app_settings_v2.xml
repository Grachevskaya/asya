<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/application">
        <Preference
            android:key="appInfo"
            app:widgetLayout="@layout/preference_more_indicator" />
        <SwitchPreferenceCompat
            android:icon="@drawable/outline_shield_24"
            android:key="enableHide"
            app:singleLineTitle="false"
            android:title="@string/app_enable_hide" />
    </PreferenceCategory>

    <PreferenceCategory
        android:dependency="enableHide"
        android:title="@string/preferences">
        <Preference
            app:widgetLayout="@layout/preference_sub_menu_indicator"
            android:key="templateConfig"
            android:icon="@drawable/outline_assignment_24"
            android:title="@string/app_template_config" />
        <SwitchPreferenceCompat
            android:icon="@drawable/outline_android_24"
            android:key="invertActivityLaunchProtection"
            app:singleLineTitle="false"
            android:title="@string/app_invert_activity_launch_protection"
            android:summary="@string/app_invert_activity_launch_protection_desc" />
    </PreferenceCategory>

    <PreferenceCategory
        android:dependency="enableHide"
        android:key="categoryVoldAppDataIsolation"
        android:title="@string/settings_vold_app_data_isolation">
        <SwitchPreferenceCompat
            android:icon="@drawable/baseline_call_split_24"
            android:key="excludeVoldIsolation"
            app:singleLineTitle="false"
            android:title="@string/app_exclude_target_installation_source" />
    </PreferenceCategory>
</PreferenceScreen>
