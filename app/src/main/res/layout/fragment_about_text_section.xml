<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/content_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?colorPrimary"
        android:paddingHorizontal="@dimen/item_padding_vertical"
        android:layout_marginBottom="@dimen/item_padding_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The description is the surface; the title above it names the page and stays on the page own tone. -->
    <com.google.android.material.card.MaterialCardView
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:strokeColor="@null"
        app:strokeWidth="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/content_description"
            android:padding="@dimen/item_padding_vertical"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
