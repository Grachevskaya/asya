<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="?attr/colorSecondaryContainer"
    app:strokeColor="@null"
    app:strokeWidth="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_outline_layers_24"
            app:tint="?attr/colorOnSecondaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:maxLines="1"
                android:ellipsize="end" />

            <com.google.android.material.chip.Chip
                android:id="@+id/card_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checkable="false"
                android:clickable="false"
                android:focusable="false"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium.Emphasized"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                app:chipMinTouchTargetSize="0dp"
                app:chipMinHeight="20dp"
                app:chipStartPadding="4dp"
                app:chipEndPadding="4dp"
                app:chipCornerRadius="4dp" />
</LinearLayout>
</LinearLayout>

</com.google.android.material.card.MaterialCardView>
